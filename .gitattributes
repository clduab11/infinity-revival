* text=auto

# Unity text serialization and GUID metadata stay ordinary Git text.
*.unity text eol=lf diff
*.prefab text eol=lf diff
*.asset text eol=lf diff
*.meta text eol=lf diff
*.mat text eol=lf diff
*.anim text eol=lf diff
*.controller text eol=lf diff
*.overrideController text eol=lf diff
*.playable text eol=lf diff
*.mask text eol=lf diff
*.lighting text eol=lf diff
*.renderTexture text eol=lf diff
*.terrainlayer text eol=lf diff
*.physicMaterial text eol=lf diff
*.physicsMaterial2D text eol=lf diff
*.fontsettings text eol=lf diff
*.guiskin text eol=lf diff
*.giparams text eol=lf diff
*.asmdef text eol=lf diff
*.asmref text eol=lf diff

# Code, configuration, and documentation remain reviewable text.
*.cs text eol=lf diff=csharp
*.shader text eol=lf
*.compute text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf

# Preserve exported Unity test receipts byte-for-byte, including their CRLFs.
docs/acceptance/evidence/*.xml -text
docs/acceptance/evidence/*.log -text

# Binary content uses Git LFS; extension patterns accept either case.
*.[bB][lL][eE][nN][dD] filter=lfs diff=lfs merge=lfs -text
