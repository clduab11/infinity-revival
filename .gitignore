/My project/
/infinity-game/
/output/
/.superpowers/

# IDE state and Unity-generated solution/project files.
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
