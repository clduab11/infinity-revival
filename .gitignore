*.pdb
*.mdb

# Local Python verification caches.
__pycache__/
*.py[cod]

# Local credentials and signing material. Commit example placeholders only.
.env
.env.*
!.env.example
!.env.template
.credentials/
.secrets/
credentials.json
credentials.*.json
secrets.json
secrets.*.json
*.key
*.pem
*.p8
*.p12
*.pfx
*.keystore
*.jks
*.mobileprovision

# OS noise and editor backups.
.DS_Store
.DS_Store?
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
*.swp
*.swo
*.blend[0-9]

# Assets/, Packages/, ProjectSettings/, and Unity .meta files are source.
# Build ignores are root-anchored so tools/build/ stays versioned.
